# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
# Huge one-line GeoJSON: keep it out of diffs and git grep output
*.geojson -diff
apps/next/public/maps/maplibre-*/** -diff

# Ensure shell scripts use LF
*.sh text eol=lf

# Ensure Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

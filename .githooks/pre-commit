#!/bin/sh
set -e
# Direct commits check working-tree files. scripts/agent-git.mjs runs this hook
# in the exact candidate checkout when staging is partial or shared.
if [ -n "$(git diff --cached --name-only --diff-filter=ACMR)" ]; then
  git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 pnpm exec oxfmt --check --no-error-on-unmatched-pattern --
fi
# Lint and typecheck only the packages affected by current changes.
pnpm turbo run lint typecheck --affected --output-logs=errors-only
# When Pages Functions are staged, typecheck them and verify the generated route table is current.
if git diff --cached --name-only | grep -q '^functions/'; then
  pnpm typecheck:api
  node scripts/build-next.mjs --inventory-only
  git diff --quiet apps/next/api-routes.generated.ts || {
    echo "api-routes.generated.ts was regenerated; stage it and commit again" >&2
    exit 1
  }
fi

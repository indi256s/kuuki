{
  "name": "kuuki",
  "version": "0.0.1",
  "private": true,
  "description": "Kuuki (空気) - Travel geek platform for flight tracking and leaderboards",
  "scripts": {
    "dev": "turbo dev",
    "dev:pages": "wrangler pages dev --compatibility-date=2024-01-01 --ip 0.0.0.0 --proxy 5173 -- pnpm --filter @kuuki/web dev",
    "dev:lan": "pnpm --filter @kuuki/web dev:lan",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "backfill:times": "npx tsx scripts/backfill-flight-times.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260131.0",
    "@supabase/supabase-js": "^2.47.0",
    "tsx": "^4.21.0",
    "turbo": "^2.4.0",
    "wrangler": "^4.62.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@google/genai": "^1.39.0",
    "@supabase/ssr": "^0.8.0"
  }
}

# Server-only settings for local composed Next Worker development (copy beside apps/next/wrangler.toml).
# Generate separate values for each secret: openssl rand -base64 32
AUTH_SECRET=
BETTER_AUTH_SECRET=
PAGES_ORIGIN=http://localhost:8800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
# Optional aircraft-search provider; Gemini remains the default.
ENRICH_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_ENRICH_MODEL=claude-haiku-5-5
MAINTENANCE_MODE=false
# Optional exact users.id; leaving this empty disables /admin/users.
ADMIN_USER_ID=

{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "./_cli.ts",
    "./migration-preflight.ts",
    "./migration-target.ts",
    "./migration-remote-reader.ts",
    "./smoke-local-runtime.ts",
    "./smoke-next-runtime.ts",
    "./generate-country-regions.ts",
    "./overview-parity.ts",
    "./restore-export-local.ts",
    "./verify-import-provider.ts",
    "./evaluate-import.ts",
    "../functions/env.d.ts"
  ]
}

{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "./_cli.ts",
    "./sb-to-d1.ts",
    "./sb-to-d1.smoke.ts",
    "./derive.ts",
    "./ship-oracle.ts",
    "./validate.ts",
    "./migration-preflight.ts",
    "./migration-target.ts",
    "./remote-migration-proposal.ts",
    "./migration-remote-reader.ts",
    "./migration-remote-validate.ts",
    "./smoke-local-runtime.ts",
    "./smoke-next-runtime.ts",
    "./generate-country-regions.ts",
    "./fit-block-time.ts",
    "./overview-backfill-proposal.ts",
    "./verify-import-provider.ts",
    "./evaluate-import.ts",
    "../functions/env.d.ts"
  ]
}
